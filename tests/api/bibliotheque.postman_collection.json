          ] } }]
        },
        {
          "name": "CT-11 EX-04 - Quatrième emprunt",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"bookId\":\"{{freeBookId}}\"}" },
            "url": "{{baseUrl}}/api/loans"
          },
          "event": [{ "listen": "test", "script": { "exec": [
