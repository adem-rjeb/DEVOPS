        }
      ]
    },
    {
      "name": "Invalid login and rate limit",
      "item": [
        {
          "name": "CT-02 EX-01 - Login invalide",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"alice@test.local\",\"password\":\"MauvaisMotDePasse\"}" },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 401', () => pm.response.to.have.status(401));"
          ] } }]
        }
      ]
    },
    {
      "name": "Défauts connus",
      "item": [
        {
          "name": "CT-19 EX-11 AN-03 - 201 caractères en tant qu'ADMIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"title\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"author\":\"Auteur\",\"totalCopies\":1}" },
            "url": "{{baseUrl}}/api/books"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('EXPECTED FAIL - required 400', () => pm.expect(pm.response.code).to.eql(400));",
            "pm.test('AN-03 actual 201 documented', () => pm.expect(pm.response.code).to.eql(201));"
          ] } }]
        },
        {
          "name": "CT-03 EX-01 AN-06 - Visitor 307 instead of 401",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/loans" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('EXPECTED FAIL - required 401', () => pm.expect(pm.response.code).to.eql(401));",
            "pm.test('AN-06 actual 307 documented', () => pm.expect(pm.response.code).to.eql(307));"
          ] } }]
        }
      ]
    }
  ]
